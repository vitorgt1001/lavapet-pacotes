# Copie este arquivo para ".env" (mesma pasta) e preencha os valores reais.
# O arquivo ".env" NUNCA deve ser compartilhado ou subido pra internet —
# ele guarda suas credenciais.

# ID da planilha do Google Sheets (fica no meio do link da planilha):
# https://docs.google.com/spreadsheets/d/ESTE_PEDACO_AQUI/edit
SPREADSHEET_ID=

# Caminho do arquivo JSON da conta de serviço do Google Cloud
# (veja o README.md, passo "Criar a conta de serviço")
GOOGLE_SERVICE_ACCOUNT_FILE=credenciais_google.json

# URL do Web App do Apps Script (Implantar > Gerenciar implantações)
APPS_SCRIPT_URL=

# O mesmo valor que você colocou em TOKEN_API_PACOTES nas
# Propriedades do script (Apps Script > Configurações do projeto)
APPS_SCRIPT_TOKEN=

# Só preencha isso se for HOSPEDAR o app na internet (Streamlit Cloud) —
# pra uso só no seu computador, pode deixar em branco.
# Senha que você e a Patrícia vão usar pra entrar no app.
APP_PASSWORD=
